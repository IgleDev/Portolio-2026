</article>

<style>
    .vigo-dino {
        --runner-bg: #222222;
        --runner-fg: #9aa0a6;
        --runner-hi: #e8eaed;
        --runner-accent: #F2A73B;
        background: var(--runner-bg);
        color: var(--runner-hi);
        border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }
    .ground {
        fill: var(--runner-fg);
    }
    .btn {
        font-weight: 700;
        padding: 0.5rem 1.5rem;
        border-radius: 9999px;
        border: 2px solid var(--runner-hi);
        transition: opacity 0.15s;
        cursor: pointer;
    }
    .btn:hover {
        opacity: 0.8;
    }
    .btn-fill {
        background: var(--runner-hi);
        color: var(--runner-bg);
    }
    .btn-outline {
        background: transparent;
        color: var(--runner-hi);
    }
    .btn:focus-visible,
    canvas:focus-visible {
        outline: 2px solid var(--runner-hi);
        outline-offset: 4px;
    }
</style>

<script>
    document.addEventListener("astro:page-load", () => {
        const root = document.querySelector<HTMLElement>("[data-dino]");
        if (!root) return;
        if (root.dataset.initialized === "true") return;
        root.dataset.initialized = "true";
        const panel = root.querySelector<HTMLElement>("#dino-game")!;
        const playBtn = root.querySelector<HTMLButtonElement>("[data-play]")!;
        const canvas = root.querySelector("canvas")!;
        const ctx = canvas.getContext("2d")!;
        const { body: BODY, legs: LEGS } = JSON.parse(root.dataset.dino!) as {
            body: string[];
            legs: string[][];
        };

        const W = 600, H = 160, GROUND = H - 28, DS = 3, BS = 4;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        ctx.scale(dpr, dpr);

        const css = getComputedStyle(root);
        const BG = css.getPropertyValue("--runner-bg").trim() || "#202124";
        const FG = css.getPropertyValue("--runner-fg").trim() || "#9aa0a6";
        const HI = css.getPropertyValue("--runner-hi").trim() || "#e8eaed";
        const FONT = css.fontFamily;

        const BOIA = [
            "...X...",
            "...X...",
            ".XXXXX.",
            "XXXXXXX",
            "XX...XX",
            "XXXXXXX",
            ".XXXXX.",
            "..XXX..",
        ];

        const PW = 16 * DS, PH = (BODY.length + 2) * DS, PX = 40;
        const OW = 7 * BS, OH = BOIA.length * BS;

        type Obstacle = { x: number; n: number };
        let state: "idle" | "run" | "over" = "idle";
        let y = GROUND - PH, vy = 0, speed = 6, score = 0, offset = 0, frameN = 0;
        let obstacles: Obstacle[] = [];
        let untilSpawn = 300, last = 0, raf = 0, hi = 0;
        try { hi = Number(localStorage.getItem("vigo-runner-hi")) || 0; } catch {}

        function sprite(rows: string[], x: number, yy: number, s: number) {
            for (let j = 0; j < rows.length; j++)
                for (let i = 0; i < rows[j].length; i++)
                    if (rows[j][i] === "X") ctx.fillRect(x + i * s, yy + j * s, s, s);
        }

        function reset() {
            y = GROUND - PH; vy = 0; speed = 6; score = 0; obstacles = []; untilSpawn = 300;
        }

        function input() {
            if (state === "run") {
                if (y >= GROUND - PH) vy = -9.5;
                return;
            }
            reset();
            state = "run";
            last = performance.now();
            raf = requestAnimationFrame(frame);
        }

        function hit(o: Obstacle) {
            const ox = o.x + 4, ow = o.n * OW - 8;
            return PX + 6 < ox + ow && PX + PW - 6 > ox && y + PH - 4 > GROUND - OH + 4;
        }

        function update(k: number) {
            vy += 0.55 * k;
            y = Math.min(y + vy * k, GROUND - PH);
            if (y >= GROUND - PH) vy = 0;

            speed = Math.min(14, speed + 0.002 * k);
            offset -= speed * k;
            score += speed * k * 0.05;
            frameN += k;

            untilSpawn -= speed * k;
            if (untilSpawn <= 0) {
                obstacles.push({ x: W + 20, n: Math.random() < 0.3 ? 2 : 1 });
                untilSpawn = 260 + Math.random() * 260;
            }
            obstacles.forEach((o) => (o.x -= speed * k));
            obstacles = obstacles.filter((o) => o.x > -OW * 2);

            if (obstacles.some(hit)) {
                state = "over";
                if (score > hi) {
                    hi = score;
                    try { localStorage.setItem("vigo-runner-hi", String(Math.floor(hi))); } catch {}
                }
            }
        }

        function render() {
            ctx.fillStyle = BG;
            ctx.fillRect(0, 0, W, H);

            ctx.fillStyle = FG;
            ctx.fillRect(0, GROUND, W, 2);
            for (let i = 0; i < 8; i++) {
                const x = (((i * 83 + offset) % W) + W) % W;
                ctx.fillRect(x, GROUND + 8 + (i % 3) * 5, 6 + (i % 2) * 6, 2);
            }

            obstacles.forEach((o) => {
                for (let n = 0; n < o.n; n++) sprite(BOIA, o.x + n * OW, GROUND - OH, BS);
            });

            ctx.fillStyle = HI;
            const onGround = y >= GROUND - PH;
            const f = state === "run" && onGround ? Math.floor(frameN / 6) % LEGS.length : 0;
            sprite(BODY, PX, y, DS);
            sprite(LEGS[f] ?? LEGS[0], PX, y + BODY.length * DS, DS);

            ctx.fillStyle = FG;
            ctx.font = `bold 14px ${FONT}`;
            ctx.textAlign = "right";
            const pad = (n: number) => String(Math.floor(n)).padStart(5, "0");
            ctx.fillText(`HI ${pad(hi)}   ${pad(score)}`, W - 12, 22);
        }

        function frame(t: number) {
            const k = Math.min((t - last) / 16.67, 3);
            last = t;
            update(k);
            render();
            if (state === "run") raf = requestAnimationFrame(frame);
        }

        function stop() {
            cancelAnimationFrame(raf);
            state = "idle";
            reset();
            render();
        }

        playBtn.addEventListener("click", () => {
            const opening = panel.hidden;
            panel.hidden = !opening;
            playBtn.setAttribute("aria-expanded", String(opening));
            playBtn.textContent = opening ? playBtn.dataset.closeLabel! : playBtn.dataset.playLabel!;
            if (opening) {
                render();
                canvas.focus();
            } else {
                stop();
            }
        });

        canvas.addEventListener("keydown", (e) => {
            if (e.code === "Space" || e.code === "ArrowUp") {
                e.preventDefault();
                input();
            }
        });
        canvas.addEventListener("pointerdown", (e) => {
            e.preventDefault();
            canvas.focus();
            input();
        });

        new IntersectionObserver(([entry]) => {
            if (!entry.isIntersecting && state === "run") stop();
        }).observe(root);
    });
</script>