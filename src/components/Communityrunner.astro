---
import type { Translations } from '@/types';

interface Props {
    t: Translations;
}

const { t } = Astro.props;

const BODY = [
    "........XXXXXXX.",
    "........XX.XXXXX",
    "........XXXXXXXX",
    "........XXXXXXXX",
    "........XXXXX...",
    "X.......XXXX....",
    "X......XXXXXX.X.",
    "XX....XXXXXXXXX.",
    "XXX..XXXXXXXXX..",
    "XXXXXXXXXXXXX...",
    ".XXXXXXXXXXXX...",
    "..XXXXXXXXXX....",
    "...XXXXXXXX.....",
];
const LEGS = [
    ["....XXX..XXX....", "....XX..........."],
    ["....XXX..XXX....", "..........XX...."],
];

const rects = [...BODY, ...LEGS[0]].flatMap((row, y) =>
    [...row].flatMap((c, x) => (c === "X" ? [{ x, y }] : []))
);
const sprite = JSON.stringify({ body: BODY, legs: LEGS });
---

