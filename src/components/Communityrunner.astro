        <h2 class="font-titulos font-bold text-4xl lg:text-5xl">{t.comunidad.title}</h2>
        <p class="text-lg lg:text-xl leading-relaxed max-w-prose">{t.comunidad.desc}</p>

        <div class="flex flex-wrap justify-center gap-4">
            <a href="https://t.me/vigo404" target="_blank" class="btn btn-fill">{t.comunidad.join}</a>
            <button
                type="button"
                class="btn btn-outline"
                aria-expanded="false"
                aria-controls="dino-game"
