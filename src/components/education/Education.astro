---
import type { EducationItem, Translations } from "@/types";
import CardEducationComponent from "../card/CardEducationComponent.astro";

interface Props {
    t: Translations;
}

const { t } = Astro.props;
---

<h2 class="text-5xl font-titulos text-titulos text-center">{t.education.title}</h2>
<div class="flex justify-center mt-10 px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 xl:gap-10 mt-10 p-4 sm:p-6">
        {t.education.educationList.map((education: EducationItem) => (
            <CardEducationComponent education={education} />
        ))}
    </div>
</div>
