---
import { Icon } from "astro-icon/components";
import type { iBlog } from '../../types/index';
import Image from "astro/components/Image.astro";

interface Props {
    blog : iBlog
}
const { blog } = Astro.props;
---

<article class="bg-[#f5f5f5] rounded-[35px] p-5 max-w-96 shadow-md border border-gray-200">
    <div class="rounded-[25px] overflow-hidden mb-6">
        <Image src=`/img/blog/${blog.imgBlog}` loading="eager" transition:name={`blog-${blog.titleHref}`} width={450} height={750} alt="Post Blog" class="w-full h-60 object-cover" />
    </div>
    <div class="flex justify-between items-center text-[10px] uppercase tracking-[2px] text-gray-500 mb-4">
        <span class="font-semibold">{blog.type}</span>
        <div class="flex items-center gap-3">
          <span class="flex items-center font-semibold"><Icon name="mdi:calendar-badge-outline" class="mr-1" />{blog.dateCreated}</span>
          <span class="flex items-center font-semibold"><Icon name="mdi:clock-outline" class='mr-1' />{blog.timeRead}</span>
        </div>
    </div>
    <h2 class="text-xl leading-tight font-medium text-black mb-8">{blog.title}</h2>
    <a href=`/blog/${blog.titleHref.toLowerCase().replace(/\s+/g, '-')}` rel="noopener noreferrer" aria-label={`Leer artículo sobre ${blog.titleHref}`}
        class="bg-black text-white px-8 py-3 rounded-2xl text-sm hover:scale-105 transition-all duration-300 shadow-lg cursor-pointer">
        Saber más
    </a>
</article>
