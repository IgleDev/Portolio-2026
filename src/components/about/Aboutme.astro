---
import { Image } from "astro:assets";

const { t } = Astro.props;
---

<h2 class="text-5xl font-bold text-noinfo font-titulos text-center pt-15">{t.about.title}</h2>
<div class="max-w-6xl mx-auto px-6 py-10 lg:py-20">
    <div class="flex flex-col-reverse lg:flex-row items-center gap-10">
        <div class="flex flex-col gap-6">
            {t.about.desc.map((p: any) => (
                <p class="text-[#898989] font-bold text-xl lg:text-3xl" set:html={p}></p>
            ))}
        </div>
        <Image src='/img/aboutme.webp' width={400} height={500} alt="About me" class="w-48 lg:w-100 shrink-0"/>
    </div>
</div>