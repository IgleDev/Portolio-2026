---
import type { Translations } from '@/types/index';
import { Icon } from 'astro-icon/components';

interface Props {
    t: Translations;
}

const { t } = Astro.props;

const navItems = t.home.nav.map((item: { title: string; id: string, external? : boolean }) => ({
    title: item.title,
    label: item.id,
    url: item.external ? `/blog` : `/#${item.id}`,
    external: item.external ?? false,
}));
---
<nav aria-label="Navegación principal" class="fixed top-4 inset-x-0 mx-auto z-10 flex items-center justify-center gap-0.5 sm:gap-1 font-medium text-gray-600 px-2 sm:px-4 py-1.5 sm:py-2 rounded-full bg-white/50 shadow-sm backdrop-blur w-max max-w-[calc(100vw-2rem)]" transition:animate="none">
    {navItems.map((link: { title: string; label: string; url: string, external? : boolean }) => (
        <a class="relative flex items-center px-2 sm:px-3 py-1 sm:py-2 rounded-full transition hover:text-[#B8860B] text-sm md:text-base whitespace-nowrap"
        aria-label={link.label} data-external={link.external ? "true" : undefined} href={link.url} rel="noopener noreferrer">
            {link.title} {link.external && <Icon name="ci:arrow-up-right-md" /> }
        </a>
    ))}
</nav>

<script>
    document.addEventListener('astro:page-load', () => {
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll("nav[aria-label='Navegación principal'] a");
    
        navLinks.forEach((link) => {
            if (link.getAttribute("data-external") === "true") return;

            link.addEventListener("click", (e) => {
                e.preventDefault();
                const href = link.getAttribute("href");
                const id = href?.replace("/#", "");
                document.getElementById(id!)?.scrollIntoView({ behavior: "smooth" });
            });
        });
    
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    navLinks.forEach((item) => {
                        item.classList.toggle("text-[#B8860B]", item.getAttribute("aria-label") === entry.target.id);
                    });
                }
            });
        }, { 
            threshold: 0.1,
            rootMargin: "-20% 0px -20% 0px"
        });
    
        sections.forEach((section) => observer.observe(section));
    });
</script>

<style>
    nav {
        animation: nav-shadow 1s linear both;
        animation-timeline: scroll();
        animation-range: 0 100px;
        background: rgba(255, 255, 255, 0.5);
    }
    @keyframes nav-shadow {
        0% { background: rgba(255, 255, 255, 0); }
        to {
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            ring: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
        }
    }
</style>