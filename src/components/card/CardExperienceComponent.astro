---
import type { Job } from '../../types/index';

interface Props {
    job: Job;
}

const { job } = Astro.props;
---
     
<div class="flex flex-col md:flex-row xl:flex-row justify-between items-start gap-6 xl:gap-12 mt-10 xl:mt-20">
    <div class="flex items-start gap-4 md:w-1/2 xl:w-1/2">
        <div class={`${job.imgClass} w-12 h-12 shrink-0 flex items-center justify-center`}>            
            <img src={job.img} loading="lazy" alt={job.companyName} class="w-full h-full object-contain" />        
        </div>
        <div>
            <h3 class="text-titulos font-bold text-xl xl:text-2xl xl:w-96">{job.title}</h3>
            <p class="text-base text-simple font-bold">{job.data}</p>
            <p class="text-base text-simple font-bold">{job.companyName}</p>
        </div>
    </div>
    <div class="flex flex-col md:w-1/2 xl:w-1/2 text-secundario text-base xl:text-xl font-bold leading-relaxed">
        {job.description}
        <a href={job.jobInfo.url} target="_blank" class="text-resaltado shrink-0 self-start">{job.jobInfo.text}</a>
    </div>
</div>