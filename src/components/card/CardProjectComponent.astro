---
import { Icon } from 'astro-icon/components';

const { project } = Astro.props;
if (!project) {
    throw new Error('El prop "project" es requerido en CardProjectComponent');
}
---

<div class="flex flex-col border border-[#C2C2C2] rounded-lg w-md h-44">
    <div class="flex justify-between items-center p-2">
        <h3 class="text-2xl font-bold p-2 text-secundario">{project.projectTitle}</h3>
        <a href={`/projects/${project.projectTitle.toLowerCase().replace(/\s+/g, '-')}`} class="p-2"><Icon name="proicons:arrow-right" class="w-5 h-5" /></a>
    </div>
    <div class="px-2 grow">
        <p class="text-secundario font-bold px-2">{project.projectDesc}</p>
    </div>
    {project.projectTech && project.projectTech.length > 0 && (
        <div class="flex flex-row w-full justify-between px-4 pb-4 gap-2">
            <div class="flex flex-row gap-2">
                {project.projectTech.map((tech : any) => (
                    <span data-tooltip={tech.name} data-position="top"><Icon name={tech.icon} class="w-6 h-6"/></span>
                ))}
            </div>
            {project.projectGithub !== "" 
                ? <a target="_blank" href={project.projectGithub}><Icon name={project.projectIcon} class="w-6 h-6" /></a>
                : <a target="_blank" href={project.projectUrl}><Icon name={project.projectIcon} class="w-6 h-6" /></a>
            }
        </div>
    )}
</div>