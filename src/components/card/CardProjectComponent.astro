---
import { Icon } from 'astro-icon/components';
import type { ProjectTech, Project } from '@/types/index';
interface Props {
    project : Project;
    lang : string;
}
const { project, lang } = Astro.props;
if (!project) {
    throw new Error('El prop "project" es requerido en CardProjectComponent');
}
---
<div class="flex flex-col border border-noinfo rounded-xl w-full md:w-full xl:w-md h-44">
    <div class="flex justify-between items-center p-2">
        <h3 class="flex items-center text-2xl font-bold text-secundario">
            <Icon name="proicons:folder-open" class="mr-2"/> {project.projectTitle}
        </h3>
        <a href={`/${lang}/projects/${project.projectTitle.toLowerCase().replace(/\s+/g, '-')}`} rel="noopener noreferrer" aria-label={`Ver detalles del proyecto ${project.projectTitle}`}>    
            <Icon name="proicons:arrow-right" class="w-5 h-5" />
        </a>
    </div>
    <div class="px-2 grow">
        <p class="text-secundario font-bold px-2">{project.projectDesc}</p>
    </div>
    {project.projectTech && project.projectTech.length > 0 && (
        <div class="flex flex-row w-full justify-between items-center px-4 pb-4 gap-2">
            <div class="flex flex-row items-center gap-2">
                {project.projectTech.map((tech : ProjectTech) => (
                    <span data-tooltip={tech.name} data-position="top"><Icon name={tech.icon} class="w-6 h-6"/></span>
                ))}
                <small class="text-xs text-titulos ml-1">{project.projectDate}</small>
            </div>
            {project.projectUrl !== "" 
                ? <a target="_blank" rel="noopener noreferrer" href={project.projectUrl} aria-label={`Mirar proyecto en la web`}><Icon name="mdi:web" class="w-6 h-6" /></a>
                : <a target="_blank" rel="noopener noreferrer" href={project.projectGithub} aria-label={`Mirar proyecto en Github`}><Icon name="proicons:github" class="w-6 h-6" /></a>
            }
        </div>
    )}
</div>