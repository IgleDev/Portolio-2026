---
import { blogs } from '@/json/blogs.json'
import { Icon } from 'astro-icon/components';
import Image from 'astro/components/Image.astro';
import BlogLayout from '@/layouts/BlogLayout.astro';
import { SITE_BLOG_DESCRIPTION, SITE_BLOG_IMAGE, SITE_BLOG_TITLE } from '@/types/consts';

export async function getStaticPaths() { 
    const paths = [];
    for (const blog of blogs) {
        paths.push({
            params: {
                name: blog.titleHref.toLowerCase().replace(/\s+/g, '-')
            },
            props: { blog }
        });
    }
    return paths;
}
const { blog } = Astro.props;
const pageTitle = `${blog.titleHref} | IgleDev`;
const pageDescription = blog.paragraph[0]?.slice(0, 160) ?? SITE_BLOG_DESCRIPTION;
const pageImage = blog.imgBlog ? `/img/blog/${blog.imgBlog}` : SITE_BLOG_IMAGE;
---
<BlogLayout title={pageTitle} description={pageDescription} image={pageImage}>
    <section class="flex justify-center">
        <article class="flex flex-col">
            <h1 class="text-center font-titulos text-5xl text-wrap">{blog.title}</h1>
            <div class="w-full flex justify-center mt-5">
                <Image transition:name={`blog-${blog.titleHref}`} width={1200} height={900} loading="eager" src={`/img/blog/${blog.imgBlog}`} alt={`Imagen del articulo sobre ${blog.titleHref}`}
                    class="w-full max-w-5xl h-125 md:h-175 object-cover rounded-[40px]"
                />
            </div>
            {blog.paragraph.map((para) => (
                <p class="text-2xl mt-10">{para}</p>
            ))}

            <div class="flex items-center justify-between mt-10">
                <div class="flex flex-col">
                    <span class="flex items-center text-noinfo"><Icon name="mdi:clock-outline" class='mr-1' /> {blog.timeRead}</span>
                    <span class="flex items-center text-noinfo"><Icon name="mdi:calendar-badge-outline" class="mr-1" /> Publicado el {blog.dateCreated}</span>
                </div>
                <a href="https://www.linkedin.com/in/adriiglesias/" target="_blank" rel="noopener noreferrer" class="text-noinfo font-bold">@IgleDev</a>
            </div>
        </article>
    </section>
</BlogLayout>