---
import { blogs } from '@/json/blogs.json'
import { Icon } from 'astro-icon/components';
import Image from 'astro/components/Image.astro';
import BlogLayout from '@/layouts/BlogLayout.astro';
import { SITE_BLOG_DESCRIPTION, SITE_BLOG_IMAGE, SITE_BLOG_TITLE } from '@/types/consts';

export async function getStaticPaths() { 
    const paths = [];
    for (const blog of blogs) {
        paths.push({
            params: {
                name: blog.titleHref.toLowerCase().replace(/\s+/g, '-')
            },
            props: { blog }
        });
    }
    return paths;
}
const { blog } = Astro.props;
const pageTitle = `${blog.titleHref} | IgleDev`;
const pageDescription = blog.paragraph[0]?.slice(0, 160) ?? SITE_BLOG_DESCRIPTION;
const pageImage = blog.imgBlog ? `/img/blog/${blog.imgBlog}` : SITE_BLOG_IMAGE;
---
<BlogLayout title={pageTitle} description={pageDescription} image={pageImage}>
    <section class="flex justify-center">
        <article class="flex flex-col w-full max-w-4xl">
            <h1 class="text-center font-titulos text-3xl sm:text-4xl md:text-5xl text-wrap px-2">
                {blog.title}
            </h1>
            <div class="w-full flex justify-center mt-5">
                <Image transition:name={`blog-${blog.titleHref}`} width={1200} height={900} loading="eager" src={`/img/blog/${blog.imgBlog}`} alt={`Imagen del articulo sobre ${blog.titleHref}`}
                    class="w-full h-56 sm:h-80 md:h-125 lg:h-175 object-cover rounded-[20px] sm:rounded-[40px]"
                />
            </div>
            <div class="px-2 sm:px-0">
                {blog.paragraph.map((para) => (
                    <p class="text-lg sm:text-xl md:text-2xl mt-8 leading-relaxed">{para}</p>
                ))}
            </div>
            <div class="flex items-center justify-between mt-10 px-2 sm:px-0 flex-wrap gap-4">
                <div class="flex flex-col gap-1">
                    <span class="flex items-center text-noinfo text-sm sm:text-base">
                        <Icon name="mdi:clock-outline" class='mr-1' /> {blog.timeRead}
                    </span>
                    <span class="flex items-center text-noinfo text-sm sm:text-base">
                        <Icon name="mdi:calendar-badge-outline" class="mr-1" /> Publicado el {blog.dateCreated}
                    </span>
                </div>
                <a href="https://www.linkedin.com/in/adriiglesias/" target="_blank" rel="noopener noreferrer" class="text-noinfo font-bold text-sm sm:text-base hover:underline">
                    @IgleDev
                </a>
            </div>
        </article>
    </section>
</BlogLayout>