---
import "@/styles/global.css";
import { Icon } from "astro-icon/components";
import type { Language } from "@/types/language.type";
import MainLayout from "@/layouts/MainLayout.astro";
import type { ProjectTech } from "@/types";
import { SITE_DESCRIPTION, SITE_IMAGE, SITE_TITLE } from "@/types/consts";
import Image from "astro/components/Image.astro";

export async function getStaticPaths() {
    const { default: es } = await import("@/i18n/es");
    const { default: en } = await import("@/i18n/en");
    const { default: gal } = await import("@/i18n/gal");

    const translations = { es, en, gal };
    const langs = ["es", "en", "gal"];
    const paths = [];

    for (const lang of langs) {
        const t = translations[lang as Language];
        for (const project of t.projects.projectList) {
            paths.push({
                params: {
                    lang,
                    name: project.projectTitle.toLowerCase().replace(/\s+/g, "-"),
                },
                props: { t, project },
            });
        }
    }
    return paths;
}

const { t, project } = Astro.props;
const { lang } = Astro.params;

const pageTitle = `${project.projectTitle} | ${SITE_TITLE}`;
const pageDescription = project.projectDescLong?.slice(0, 160) ?? SITE_DESCRIPTION;
const pageImage = project.projectImg?.[0]?.src ?? SITE_IMAGE;

const details = t.projects.projectInfoResult
    .map((title: string, i: number) => ({
        title,
        text: project.projectInformation?.[i],
    }))
    .filter((d: { text?: string }) => d.text);


const linkify = (text: string) =>
    text.replace(
        /\b((?:[a-z0-9-]+\.)?bretemahr\.com)\b/gi,
        '<a href="https://$1" target="_blank" rel="noopener noreferrer" class="font-bold text-titulos underline underline-offset-4 hover:opacity-70 transition">$1</a>'
    );

const hasGithub = project.projectGithub !== "";
const ctaHref = hasGithub ? project.projectGithub : project.projectUrl;
---

<MainLayout title={pageTitle} description={pageDescription} image={pageImage} lang={lang} t={t}>
    <section class="px-6 py-10 lg:p-20 max-w-7xl mx-auto">
        <!-- Cabeceira -->
        <header class="flex items-center gap-3 mb-10">
            <a
                rel="noopener noreferrer"
                href={`/${lang}`}
                aria-label={"Back"}
                class="text-secundario hover:text-titulos transition"
            >
                <Icon name="proicons:arrow-left" class="w-5 h-5" />
            </a>
            <h1 class="text-4xl lg:text-5xl font-titulos font-bold text-titulos">
                {project.projectTitle}
            </h1>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
            <div class="flex flex-col gap-6">
                <p class="text-secundario font-bold text-lg lg:text-xl leading-relaxed max-w-prose">
                    {project.projectDescLong}
                </p>

                {project.projectTech?.length > 0 && (
                    <div class="flex flex-col gap-3">
                        <h2 class="text-titulos font-bold text-xl">{t.projects.projectTech}</h2>
                        <ul class="flex flex-wrap gap-3">
                            {project.projectTech.map((tech: ProjectTech) => (
                                <li class="flex items-center gap-2 border border-noinfo rounded-full px-3 py-1 text-sm font-bold text-secundario">
                                    <Icon name={tech.icon} class="w-5 h-5" />
                                    {tech.name}
                                </li>
                            ))}
                        </ul>
                    </div>
                )}

                <div class="mt-2">
                    <a
                        rel="noopener noreferrer"
                        href={ctaHref}
                        target="_blank"
                        class="inline-flex items-center gap-2 bg-titulos text-white px-5 py-2 rounded-full font-semibold hover:bg-[#333333] transition-colors"
                    >
                        <Icon name={hasGithub ? "proicons:github" : project.projectIcon} class="w-5 h-5" />
                        {hasGithub ? "GitHub" : project.projectInfo}
                    </a>
                </div>
            </div>

            {project.projectImg?.length > 0 && (
                <div class="lg:sticky lg:top-10">
                    <Image
                        width={525}
                        height={700}
                        loading="eager"
                        src={project.projectImg[0].src}
                        alt={project.projectImg[0].alt}
                        class="w-full max-h-175 object-contain rounded-2xl"
                    />
                </div>
            )}
        </div>

        {details.length > 0 && (
            <dl class="mt-16 lg:mt-24 border-t border-noinfo">
                {details.map((d: { title: string; text: string }) => (
                    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-2 lg:gap-16 py-6 lg:py-8 border-b border-noinfo">
                        <dt class="text-titulos font-titulos font-bold text-2xl">
                            {d.title}
                        </dt>
                        <dd class="text-secundario text-lg lg:text-xl leading-relaxed max-w-prose" set:html={linkify(d.text)} />
                    </div>
                ))}
            </dl>
        )}
    </section>
</MainLayout>