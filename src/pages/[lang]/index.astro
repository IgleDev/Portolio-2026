---
import es from "@/i18n/es";
import en from "@/i18n/en";
import gal from "@/i18n/gal";
import type { Language } from "@/types/language.type";
import Hero from "@/components/Hero.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import Experiencia from "@/components/experiencia/Experiencia.astro";
import Proyectos from "@/components/proyectos/Proyectos.astro";
import Education from "@/components/education/Education.astro";
import Aboutme from "@/components/about/Aboutme.astro";
import Recomendaciones from "@/components/recomendaciones/Recomendaciones.astro";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params : { lang : "gal" }}, { params: { lang: "en" }}];
}

export const defaultRedirect = "/es";

const lang = Astro.params.lang as Language;
const translations = { es, gal, en };
const t = translations[lang];

if(!t) {
  return Astro.redirect('/404');
}
---

<MainLayout isIndex={true} lang={lang} t={t}>
  <Hero lang={lang} t={t} />
  <section id="experiencia">
    <Experiencia t={t} />
  </section>
  <section id="proyectos" class="mt-20">
    <Proyectos t={t} lang={lang}/>
  </section>
  <section id="educacion" class="mt-30">
    <Education t={t} />
  </section>
   <section id="recomendaciones" class="mt-20">
    <Recomendaciones t={t} />
  </section>
  <section id="sobre-mi" class="mt-20 bg-titulos p-0">
    <Aboutme t={t} />
  </section>
</MainLayout>