---
import "../styles/global.css";
import "../styles/webcore.scss"
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_BLOG_DESCRIPTION, SITE_BLOG_TITLE } from "../types/consts";
import { Icon } from "astro-icon/components";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title = SITE_BLOG_TITLE, description = SITE_BLOG_DESCRIPTION, image } = Astro.props;
---
<!doctype html>
<html lang='es'>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <ClientRouter />
  </head>
  <body class="bg-[#F6F4F2]">
    <main class="mt-16 sm:mt-20 md:mt-30">
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
        <button id="back-btn" aria-label="Volver" class="text-secundario hover:text-titulos transition cursor-pointer mb-6">
          <Icon name="proicons:arrow-left" class="w-8 h-8 sm:w-10 sm:h-10" />
        </button>
        <slot />
      </section>
    </main>
  </body>
</html>

<script>
  import { navigate } from 'astro:transitions/client';

  function initBackBtn() {
    const btn = document.getElementById('back-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const path = window.location.pathname;
      if (path === '/blog' || path === '/blog/') {
        navigate('/');
      } else if (document.referrer !== '' && document.referrer.includes(window.location.origin)) {
        history.back();
      } else {
        navigate('/blog');
      }
    });
  }

  initBackBtn();
  document.addEventListener('astro:page-load', initBackBtn);
</script>