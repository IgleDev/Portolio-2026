---
import "../styles/global.css";
import "../styles/webcore.scss";

import { ClientRouter } from "astro:transitions";

import BaseHead from "../components/BaseHead.astro";
import { SITE_404, SITE_404_DESCRIPTION } from "../types/consts";
import Header from "../components/Header.astro";

interface Props { lang: string; t: any; isIndex?: boolean; title?: string; description?: string; image?: string; }
const { lang, t, isIndex = false, title = SITE_404, description = SITE_404_DESCRIPTION, image } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <ClientRouter />
  </head>

  <body class="bg-[#F6F4F2]">
    <main class="min-h-[calc(100vh-80px)] flex items-center justify-center">
      <slot />
    </main>
  </body>
</html>