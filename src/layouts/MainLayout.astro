---
import "../styles/global.css";
import "../styles/webcore.scss"
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../types/consts";
import Header from "../components/Header.astro";

interface Props {
  lang: string;
  t: any;
  isIndex?: boolean;
  title?: string;
  description?: string;
  image?: string;
}

const { lang, t, isIndex = false, title = SITE_TITLE, description = SITE_DESCRIPTION, image } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image}>
    <ClientRouter />
  </head>
  <body class="bg-[#F6F4F2]">
    <Header lang={lang} t={t} isIndex={isIndex} />
    <main class="mt-10">
      <slot />
    </main>
	<body/>
</html>